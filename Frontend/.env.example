# Environment Variables — CAIA Frontend
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Base URL for the CAIA REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Application name (used in page titles, headers)
VITE_APP_NAME=CAIA

# Application version (optional — matches backend version)
VITE_APP_VERSION=1.0.0

# Environment label (development | staging | production)
VITE_APP_ENV=development
